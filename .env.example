# ---------------------------------------------------------------------------
# RAHAT + NETRA Unified Environment Configuration
# Copy this file to .env and customize for your local setup.
# NEVER commit .env to version control!
# ---------------------------------------------------------------------------

# === RAHAT Core Settings ===
RAHAT_INFER_MODE=real
# RAHAT_DATA_DIR=./geoserv/test_data
# RAHAT_WORK_DIR=./inference_api/work
# RAHAT_MODEL_DIR=./inference_api/models
RAHAT_GEOSERV_URL=http://127.0.0.1:8088
RAHAT_DEVICE=cpu
RAHAT_API_HOST=127.0.0.1
RAHAT_API_PORT=8099
RAHAT_MAX_UPLOAD_MB=512
RAHAT_MAX_JOBS=4
RAHAT_MIN_AREA=20
# Copernicus Sentinel Hub Credentials (https://dataspace.copernicus.eu/)
SH_CLIENT_ID=your-copernicus-client-id-here
SH_CLIENT_SECRET=your-copernicus-client-secret-here
SH_BASE_URL=https://sh.dataspace.copernicus.eu
SH_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token

# Polygon Amoy Testnet (Chain ID: 80002)
POLYGON_AMOY_RPC=https://polygon-amoy.drpc.org
POLYGON_WALLET_ADDRESS=your-polygon-wallet-address-here
POLYGON_PRIVATE_KEY=your-polygon-private-key-here
POLYGONSCAN_BASE_URL=https://amoy.polygonscan.com
CONTRACT_ADDRESS=0x49Eb908303f4902e8c3dB7b75623E14B2Fb566Da
